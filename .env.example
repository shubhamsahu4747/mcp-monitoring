AUTH_TIMEOUT_SECONDS=30.0
REDACT_KEYS=password,secret,token,api_key,authorization,private_key,access_token,credential,secret_key
DATABASE_PATH=data/audit.db

DEFAULT_UPSTREAM_COMMAND=python
DEFAULT_UPSTREAM_ARGS=examples/mock_mcp_server.py
UPSTREAM_SERVER_NAME=Safe Mock MCP Server

REMOTE_HOST=127.0.0.1
REMOTE_PORT=8765
REMOTE_MODE=development

AGENT_AUTH_TOKEN=change-this-secure-desktop-token-in-production
REMOTE_CLIENT_API_KEY=change-this-secure-client-api-key-in-production

RATE_LIMIT_PER_MINUTE=60
REMOTE_CORS_ORIGINS=*
LOG_LEVEL=INFO
