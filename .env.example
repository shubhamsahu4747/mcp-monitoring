# ==============================================================================
# Walled AI - MCP Security Gateway Configuration Template
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit the active '.env' file or production secrets to source control.
# ==============================================================================

# Authorization Engine Settings
AUTH_TIMEOUT_SECONDS=30.0

# Sensitive parameter keys to redact in desktop popups, notifications, and audit logs
REDACT_KEYS=password,secret,token,api_key,authorization,private_key,access_token,credential,secret_key

# SQLite Audit Database Storage Path
DATABASE_PATH=data/audit.db

# Default Upstream MCP Server (used by local stdio proxy)
DEFAULT_UPSTREAM_COMMAND=python
DEFAULT_UPSTREAM_ARGS=examples/mock_mcp_server.py
UPSTREAM_SERVER_NAME=Safe Mock MCP Server

# Remote Gateway Network Settings (FastAPI / Uvicorn)
REMOTE_HOST=127.0.0.1
REMOTE_PORT=8765
REMOTE_MODE=development

# Security Credentials
# 1. AGENT_AUTH_TOKEN: Used to authenticate the desktop agent WebSocket (/ws/agent)
AGENT_AUTH_TOKEN=change-this-secure-desktop-token-in-production

# 2. REMOTE_CLIENT_API_KEY: Used by remote MCP clients (e.g. Claude Web) via Bearer or X-API-Key
REMOTE_CLIENT_API_KEY=change-this-secure-client-api-key-in-production

# Rate Limiting (maximum allowed requests per minute per remote client IP or token)
RATE_LIMIT_PER_MINUTE=60

# CORS Allowed Origins (comma-separated list, e.g. "https://claude.ai,https://example.com" or "*")
REMOTE_CORS_ORIGINS=*

# Diagnostics & Logging (Written exclusively to sys.stderr to keep sys.stdout clean for MCP stdio)
LOG_LEVEL=INFO
